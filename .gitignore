# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# ---------------------------------------------------------------------------
# Project-specific ignores (Standards § 8.1 / § 8.4).
# Every non-obvious rule is commented — WHY it is here, not what it is.
# ---------------------------------------------------------------------------

# Regenerable test/CI output (test_results.xml, plots, coverage reports).
# Anything a script can rebuild does not belong in git.
Output/

# Retired code kept LOCALLY for reference; never committed.
# Standards § 1.1 and § 8.1: `deprecated/` archives are the canonical
# uncommitted-but-preserved case. `git rm --cached -r deprecated`
# untracks whatever was previously committed; this rule prevents
# re-adding.  Case matters on Linux/macOS — use lowercase.
deprecated/

# Raw upstream reference material — R&D chapter scans, ISO 19108,
# any book excerpts.  Standards § 8.3 says these live in an
# out-of-project DATA-SOURCES folder; until they are physically
# moved off the project tree, keep them untracked here.
Documentation/
docs/**/*.pdf
docs/**/*.PDF

# Root-level scratch (underscore prefix convention, Standards § 8.1).
# One-off diagnostics and probes live at the repo root as `_name.py`
# and never get committed.
/_*.py
/_*.txt
/_*.log

# ---------------------------------------------------------------------------
# Editor / IDE config
# ---------------------------------------------------------------------------
# Allowlist the shared VS Code files (Standards § 8.1); ignore
# per-user churn (workspace state, launch configs).
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/tasks.json
.idea/
*.swp
*.swo
*~

# ---------------------------------------------------------------------------
# Python build / packaging artifacts
# ---------------------------------------------------------------------------
# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
pip-wheel-metadata/
share/python-wheels/
*.egg-info/
spk_universal_timestamp.egg-info/
.installed.cfg
*.egg
MANIFEST

# PyInstaller
#  Usually these files are written by a python script from a template
#  before PyInstaller builds the exe, so as to inject date/other infos into it.
*.manifest
*.spec

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage reports
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/

# Translations
*.mo
*.pot

# Django stuff:
*.log
local_settings.py
db.sqlite3
db.sqlite3-journal

# Flask stuff:
instance/
.webassets-cache

# Scrapy stuff:
.scrapy

# Sphinx documentation
docs/_build/

# PyBuilder
target/

# Jupyter Notebook
.ipynb_checkpoints

# IPython
profile_default/
ipython_config.py

# pyenv
.python-version

# pipenv
#   According to pypa/pipenv#598, it is recommended to include Pipfile.lock in version control.
#   However, in case of collaboration, if having platform-specific dependencies or dependencies
#   having no cross-platform support, pipenv may install dependencies that don't work, or not
#   install all needed dependencies.
#Pipfile.lock

# PEP 582; used by e.g. github.com/David-OConnor/pyflow
__pypackages__/

# Celery stuff
celerybeat-schedule
celerybeat.pid

# SageMath parsed files
*.sage.py

# Environments
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# Spyder project settings
.spyderproject
.spyproject

# Rope project settings
.ropeproject

# mkdocs documentation
/site

# mypy
.mypy_cache/
.dmypy.json
dmypy.json

# Pyre type checker
.pyre/

# OS
.DS_Store
Thumbs.db

